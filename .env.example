PORT=8080
HOST=127.0.0.1
AI_MODE=demo
STORE_MODE=local
# To enable Gemini later: AI_MODE=vertex, GOOGLE_CLOUD_PROJECT, VERTEX_LOCATION and GEMINI_MODEL.
# Authenticate with Application Default Credentials. Never put credentials in frontend code.
# GOOGLE_CLOUD_PROJECT=your-project-id
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
# STORE_MODE=firestore enables a Firestore transaction-backed repository.
APP_ACCESS_KEY=replace-with-a-long-random-secret
# Production requires APP_ACCESS_KEY. Replace the prototype shared key with OIDC/SAML before enterprise use.
